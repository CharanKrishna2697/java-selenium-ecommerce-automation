<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Test Suite">

    <listeners>
        <listener class-name="com.automation.reporting.ExtentReportListener"/>
    </listeners>

    <test name="Regression Tests">

        <groups>

            <run>
                <include name="regression"/>
            </run>

        </groups>

        <classes>
            <class name="com.automation.reporting.ReportConfiguration"/>
            <class name="com.automation.tests.LoginTest"/>
            <class name="com.automation.tests.ProductsTest"/>
            <class name="com.automation.tests.CheckoutTest"/>
            <class name="com.automation.tests.DataDrivenLoginTest"/>
        </classes>

    </test>

</suite>